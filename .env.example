# Copy to .env and fill in. Never commit .env.

# --- LLM for the TrueForge agent: openai, anthropic or custom ---
# custom = any OpenAI-compatible endpoint, e.g. the TrueFoundry AI gateway
LLM_PROVIDER=custom
CUSTOM_PROVIDER_NAME=gpt-model
CUSTOM_PROVIDER_BASE_URL=https://gateway.truefoundry.ai
CUSTOM_PROVIDER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Agent model. Blank = provider default (custom: vm-polaris/openai)
TRUEFORGE_MODEL_ID=openai-polaris/gpt-4o
# Retrying relay in front of the custom gateway (orchestrator/llm-relay.ts)
LLM_RELAY=true
LLM_RELAY_PORT=8767

# --- Jev (risk scoring) ---
# Option A (default): real Jev through Vercel AI Gateway, via the local Jev bridge.
TYPESAFE_BASE_URL=http://127.0.0.1:8766
TYPESAFE_API_KEY=any-long-random-string-the-bridge-checks
JEV_BACKEND=vercel
AI_GATEWAY_API_KEY=
# Option B: JEV_BACKEND=trueforge-judge uses a mock (TrueForge judge sessions) instead.
JEV_MOCK_PORT=8766
JEV_MOCK_MODEL_ID=openai-polaris/gpt-4o
JEV_MOCK_SAMPLES=3
JEV_MOCK_TEMPERATURE=1.0
# Option C: a direct TypeSafe key. Delete TYPESAFE_BASE_URL and put the key in TYPESAFE_API_KEY.

# --- Daytona sandbox (optional; blank = TrueForge's local sandbox) ---
DAYTONA_API_KEY=

# --- TrueForge server (local mode) ---
TRUEFORGE_PORT=8790
TRUEFORGE_URL=http://localhost:8790
TRUEFORGE_API_KEY=trueforge-standalone
TRUEFORGE_AGENT_NAME=faah-oncall

# --- Faah MCP tool server (Python) ---
FAAH_MCP_PORT=8765
# Shared secret between TrueForge, the orchestrator and the MCP server: openssl rand -hex 32
FAAH_MCP_TOKEN=

# --- Orchestrator ---
DASHBOARD_PORT=3000
# The ONLY port to expose through a tunnel
WEBHOOK_PORT=3001
AUTO_OPEN_DASHBOARD=true

# --- Inbound email ---
MAILGUN_WEBHOOK_SIGNING_KEY=
SENDGRID_INBOUND_SECRET=
